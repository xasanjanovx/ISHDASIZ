[Unit]
Description=ISHDASIZ leased import continuation
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
LoadCredential=cron-secret:/etc/ishdasiz-server/import-worker-key
ExecStart=/usr/bin/python3 /usr/local/lib/ishdasiz/run-import-continuation.py
TimeoutStartSec=300
MemoryMax=64M
CPUQuota=10%
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET
IPAddressDeny=any
IPAddressAllow=127.0.0.1/32
LogRateLimitIntervalSec=30s
LogRateLimitBurst=5

